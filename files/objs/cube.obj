# Simple cube centered at origin in object space
# Size: 2x2x2 (from -1 to 1 on each axis)

# 8 vertices
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1

# 12 triangular faces (2 per side)

# Front face (z = -1)
f 1 2 3
f 1 3 4

# Back face (z = 1)
f 6 5 8
f 6 8 7

# Left face (x = -1)
f 5 1 4
f 5 4 8

# Right face (x = 1)
f 2 6 7
f 2 7 3

# Bottom face (y = -1)
f 5 6 2
f 5 2 1

# Top face (y = 1)
f 4 3 7
f 4 7 8
